[Unit]
Description=Spice Monitor MQTT to PostgreSQL Receiver
After=network-online.target mosquitto.service postgresql.service
Wants=network-online.target

[Service]
Type=simple

User=pi
Group=pi

WorkingDirectory=/home/pi/spice_monitor
EnvironmentFile=/home/pi/spice_monitor/.env

ExecStart=/home/pi/spice_monitor/.venv/bin/python /home/pi/spice_monitor/receiver.py

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
