# ------------------------------------------------------------
# Supabase
# ------------------------------------------------------------
# Project Settings -> API -> Project URL
SUPABASE_URL=https://your-project.supabase.co

# Use the service_role key on the Raspberry Pi only.
# NEVER commit this file or expose the key in a browser/app.
SUPABASE_KEY=your-service-role-key

SUPABASE_BUCKET=thermal-captures
SUPABASE_TABLE=sensor_readings

# ------------------------------------------------------------
# MQTT (receiver credentials created with mosquitto_passwd)
# ------------------------------------------------------------
MQTT_BROKER=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=spice_db_receiver
MQTT_PASSWORD=replace-with-a-strong-mqtt-password
MQTT_TOPIC=spice/sensor/data

# ------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=spice_db
DB_USER=spice_app
DB_PASSWORD=replace-with-a-strong-database-password

# ------------------------------------------------------------
# Capture / sync intervals (seconds)
# ------------------------------------------------------------
CAPTURE_INTERVAL=30
SYNC_INTERVAL=60
SYNC_BATCH_SIZE=100
